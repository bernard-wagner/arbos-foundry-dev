new file mode 100644
index 000000000..ef20f0156
--- /dev/null
+++ b/crates/anvil/bin/anvil_alias.rs
@@ -0,0 +1,14 @@
+// Alias binary for backwards compatibility and tests.
+// This is identical to arbos-anvil.
+
+use anvil::args::run;
+
+#[global_allocator]
+static ALLOC: foundry_cli::utils::Allocator = foundry_cli::utils::new_allocator();
+
+fn main() {
